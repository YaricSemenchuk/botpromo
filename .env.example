# Telegram userbot credentials (my.telegram.org, на выделенный номер)
TG_API_ID=
TG_API_HASH=
# Получить через scripts/generate_session.py (разовый интерактивный логин)
TG_SESSION_STRING=

# CRM webhook (см. контракт в стартовом пакете)
CRM_ENDPOINT=https://pm-crm-production.up.railway.app/api/inbound/lead
INBOUND_TOKEN=

# true = классифицировать и логировать, но НЕ отправлять в CRM
DRY_RUN=true

# Пути (по умолчанию — относительно репозитория, менять не обязательно)
DB_PATH=data/tgparser.db
GROUPS_PATH=config/groups.yaml

# Алерты на 401/422/исчерпанные ретраи (отдельный обычный бот, не userbot)
ALERT_BOT_TOKEN=
ALERT_CHAT_ID=

# Таймауты/ретраи sender'а
HTTP_TIMEOUT_SECONDS=10
MAX_RETRY_ATTEMPTS=8
RETRY_BACKOFF_BASE_SECONDS=2
RETRY_BACKOFF_MAX_SECONDS=300
